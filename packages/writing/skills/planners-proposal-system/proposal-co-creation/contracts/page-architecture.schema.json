{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal Storyline",
  "description": "每页一句主张和可展开的支撑判断；允许保存未完成草稿，交接前另检查支撑。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_id",
    "storyline_thesis",
    "sections",
    "pages"
  ],
  "properties": {
    "contract_version": {
      "const": "3.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^pj_[a-f0-9]{24}$"
    },
    "storyline_thesis": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "title"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^sec-[a-z0-9][a-z0-9-]{1,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_number",
          "section_id",
          "claim",
          "supports"
        ],
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "section_id": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
